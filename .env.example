# Backlink index used to discover board participants.
# Default: https://constellation.microcosm.blue (Constellation is open source,
# so you can point this at your own instance).
VITE_CONSTELLATION_URL=https://constellation.microcosm.blue

# Firehose used for real-time board updates.
# Default: wss://jetstream2.us-east.bsky.network/subscribe
VITE_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
